# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ornek env dosyasi repoya dahil
!.env.local.example

# dis sinyal olcum dosyalari (scripts/ingest-signals.mjs --sablon)
# Ara dosyalardir: olcumun kendisi kaynagi ve tarihiyle birlikte katalog
# dosyalarina ve veritabanina isleniyor, kayit orada tutuluyor.
olcumler-*.json
olcumler.json

# vercel
.vercel/
