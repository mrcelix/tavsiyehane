# Supabase bağlantısı — supabase.com > Project Settings > API'den kopyalayın.
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# Anahtarlar tanımlı DEĞİLKEN site yerleşik demo veriyle çalışır (tam işlevsel önizleme).

NEXT_PUBLIC_SUPABASE_URL=https://XXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Yalnızca `npm run seed` için gerekir; tarayıcıya asla gönderilmez. GİZLİ TUTUN.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare Turnstile site anahtarı (bot koruması). Tanımlı değilse widget
# çizilmez ve kayıt akışı aynen çalışır. Secret anahtar buraya DEĞİL, Supabase
# > Authentication > Bot and Abuse Protection'a girilir.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare görüntü dönüştürme açıksa 1 yapın; yoksa görseller optimize
# edilmeden ama sorunsuz servis edilir.
NEXT_PUBLIC_CF_IMAGES=
